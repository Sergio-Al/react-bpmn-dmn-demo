{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Loan application v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["applicantAge", "monthlyIncome", "amount", "termMonths"],
  "properties": {
    "applicantAge": { "type": "integer", "minimum": 18, "maximum": 100 },
    "monthlyIncome": { "type": "number", "exclusiveMinimum": 0 },
    "amount": { "type": "number", "exclusiveMinimum": 0 },
    "termMonths": { "type": "integer", "enum": [12, 24, 36, 48] }
  },
  "examples": [{ "applicantAge": 30, "monthlyIncome": 5000, "amount": 20000, "termMonths": 24 }]
}
