<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_HighValueOrder" targetNamespace="https://example.org/high-value-order">
  <bpmn:process id="high-value-order" name="High-value order" isExecutable="true">
    <bpmn:startEvent id="start" name="Start"><bpmn:outgoing>flow-start-rule</bpmn:outgoing></bpmn:startEvent>
    <bpmn:businessRuleTask id="determine-discount" name="Determine discount" camunda:decisionRef="order-discount" implementation="${environment.services.evaluateDecision}"><bpmn:incoming>flow-start-rule</bpmn:incoming><bpmn:outgoing>flow-rule-review</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:serviceTask id="flag-for-review" name="Flag for review" implementation="${environment.services.flagForReview}"><bpmn:incoming>flow-rule-review</bpmn:incoming><bpmn:outgoing>flow-review-end</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="end" name="End"><bpmn:incoming>flow-review-end</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="flow-start-rule" sourceRef="start" targetRef="determine-discount" />
    <bpmn:sequenceFlow id="flow-rule-review" sourceRef="determine-discount" targetRef="flag-for-review" />
    <bpmn:sequenceFlow id="flow-review-end" sourceRef="flag-for-review" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_HighValueOrder"><bpmndi:BPMNPlane id="Plane_HighValueOrder" bpmnElement="high-value-order">
    <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="90" y="180" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="rule_di" bpmnElement="determine-discount"><dc:Bounds x="190" y="158" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="review_di" bpmnElement="flag-for-review"><dc:Bounds x="390" y="158" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="590" y="180" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="flow-start-rule_di" bpmnElement="flow-start-rule"><di:waypoint x="126" y="198" /><di:waypoint x="190" y="198" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="flow-rule-review_di" bpmnElement="flow-rule-review"><di:waypoint x="310" y="198" /><di:waypoint x="390" y="198" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="flow-review-end_di" bpmnElement="flow-review-end"><di:waypoint x="510" y="198" /><di:waypoint x="590" y="198" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
